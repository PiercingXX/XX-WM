#!/bin/sh
# Runs inside the phoc session. Start the on-screen keyboard (squeekboard,
# with the PiercingXX Colemak layouts) before the shell; squeekboard shows
# and hides itself on input-method activation, and the shade/lock windows
# sit on higher layers.
if command -v squeekboard >/dev/null 2>&1; then
    squeekboard &
fi

# System-level gestures: lisgd reads the touchscreen evdev directly, so edge
# swipes work while any app is focused — each binding feeds the shell IPC.
# Override autodetection with PIERCING_TOUCH_DEV=/dev/input/eventN.
if command -v lisgd >/dev/null 2>&1; then
    _touch_dev=${PIERCING_TOUCH_DEV:-$(awk '
        /^N:/ { name = tolower($0) }
        /^H:/ && name ~ /touch/ {
            for (i = 1; i <= NF; i++)
                if ($i ~ /^event/) { print "/dev/input/" $i; exit }
        }' /proc/bus/input/devices)}
    if [ -n "$_touch_dev" ] && [ -r "$_touch_dev" ]; then
        lisgd -d "$_touch_dev" \
            -g "1,DU,B,*,R,@bindir@/piercing-ipc gesture.home" \
            -g "1,UD,T,*,R,@bindir@/piercing-ipc gesture.shade" \
            -g "1,LR,L,*,R,@bindir@/piercing-ipc gesture.back" \
            -g "1,RL,R,*,R,@bindir@/piercing-ipc gesture.back" &
    else
        echo "piercing-shell: no readable touchscreen for lisgd" >&2
    fi
fi

# gtk4-layer-shell MUST be loaded before libgtk-4, or every layer surface
# (shade, lock screen, switcher, call UI) silently falls back to a normal
# decorated window and the home screen falls back to fullscreen. Python
# imports GTK first, so preload the library. Path differs by distro/arch —
# resolve it via ldconfig, then a multiarch glob.
_ls_lib=$(ldconfig -p 2>/dev/null | awk '/libgtk4-layer-shell\.so\.0/ {print $NF; exit}')
if [ -z "$_ls_lib" ]; then
    for _p in /usr/lib/libgtk4-layer-shell.so.0 /usr/lib/*/libgtk4-layer-shell.so.0; do
        [ -e "$_p" ] && _ls_lib="$_p" && break
    done
fi
if [ -n "$_ls_lib" ]; then
    export LD_PRELOAD="${LD_PRELOAD:+$LD_PRELOAD:}$_ls_lib"
fi

exec @python@ @shell_dir@/main.py "$@"