#!/bin/sh
# Runs inside the phoc session. Start the on-screen keyboard (squeekboard,
# with the PiercingXX Colemak layouts) before the shell; squeekboard shows
# and hides itself on input-method activation, and the shade/lock windows
# sit on higher layers.
if command -v squeekboard >/dev/null 2>&1; then
    squeekboard &
fi
exec @python@ @shell_dir@/main.py "$@"