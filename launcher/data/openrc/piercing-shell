#!/sbin/openrc-run
# Piercing WM shell session — OpenRC equivalent of the systemd user unit.
# postmarketOS default images run OpenRC; supervise-daemon respawns on failure.

name="piercing-shell"
description="Piercing WM shell session"

: "${PIERCING_USER:=user}"

command="/usr/libexec/piercing-session"
command_user="${PIERCING_USER}"
command_background=false
supervisor=supervise-daemon
respawn_delay=2
respawn_max=0
output_log="/var/log/piercing-shell.log"
error_log="/var/log/piercing-shell.log"

depend() {
    need localmount
    after bootmisc
    want elogind
}

start_pre() {
    checkpath -f -o "${PIERCING_USER}" "$output_log"
}
